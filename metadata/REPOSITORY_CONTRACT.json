{
  "schema": "surge.repository.v1",
  "source_directories": [
    ".github",
    "cmake",
    "docs",
    "exports",
    "governance",
    "include",
    "metadata",
    "resources",
    "scripts",
    "src",
    "tests",
    "third_party",
    "tools"
  ],
  "required_files": [
    "AGENTS.md",
    "README.md",
    "CMakeLists.txt",
    "CMakePresets.json",
    "RELEASE_STATE.json",
    "docs/DEVELOPMENT.md",
    "docs/GOLDEN_PROTOCOLS.md",
    "docs/ROOT_LAYOUT_AND_BUILD_OWNERSHIP.md",
    "docs/VALIDATION.md",
    "governance/CURRENT_SCOPE.md",
    "metadata/INTEGRATION_REQUIREMENTS.json",
    "metadata/INFRASTRUCTURE_TRANSFER_MATRIX.json",
    "metadata/METADATA_OWNERSHIP.json",
    "metadata/EVIDENCE_RETENTION_POLICY.json",
    "metadata/HUMAN_ENTRYPOINT_REGISTRY.json",
    "resources/branding/surge.png",
    "docs/IDENTIFIER_POLICY.md",
    ".gitattributes",
    ".github/workflows/ci.yml",
