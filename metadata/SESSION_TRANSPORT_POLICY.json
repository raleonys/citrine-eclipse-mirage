  "admission": "PAUSE_ACCEPT_AT_SHARED_CAP_RESUME_ON_RETIRE; CHECK_COMPLETING_ACCEPTS_FROM_BOTH_FAMILIES_BEFORE_FACTORY",
  "stop": "CANCEL_TIMERS_AND_SOCKETS_DISCARD_QUEUED_JOIN_RUNNING_DRAIN_IO",
