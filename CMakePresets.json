{
  "version": 3,
  "configurePresets": [
    {
      "name": "llvm-mingw-x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/llvm-mingw-x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/llvm-mingw-x64.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "llvm-mingw-x64-vendors",
      "inherits": "llvm-mingw-x64",
      "binaryDir": "${sourceDir}/build/llvm-mingw-x64-vendors",
      "cacheVariables": {
        "CITRINE_ECLIPSE_MIRAGE_REQUIRE_VENDOR_COMPATIBILITY": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "dll", "configurePreset": "llvm-mingw-x64", "targets": ["citrine_eclipse_mirage", "citrine_eclipse_mirage_runtime_host", "citrine_eclipse_mirage_source_host"]},
    {"name": "tests", "configurePreset": "llvm-mingw-x64"},
    {"name": "vendors", "configurePreset": "llvm-mingw-x64-vendors"}
  ]
}
