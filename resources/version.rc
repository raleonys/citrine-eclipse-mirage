#include <windows.h>
#include "project_version.h"

// Strict PE metadata allowlist: VERSIONINFO only (#1/#2/#3).
// Project identity and the selected semantic release version are authoritative.
1 VERSIONINFO
 FILEVERSION CEM_VERSION_NUMERIC
 PRODUCTVERSION CEM_VERSION_NUMERIC
 FILEFLAGSMASK 0x0000003fL
 FILEFLAGS 0x00000000L
 FILEOS 0x00040000L
 FILETYPE 0x00000002L
 FILESUBTYPE 0x6a1aae62L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Citrine Eclipse Mirage\0"
            VALUE "FileVersion", CEM_VERSION_STRING
            VALUE "LegalCopyright", "Copyright 2026 SURGE. All rights reserved.\0"
            VALUE "ProductName", "Citrine Eclipse Mirage\0"
            VALUE "ProductVersion", CEM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
