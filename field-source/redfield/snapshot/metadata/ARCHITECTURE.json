  "boundary": "Structural unification and removed legacy API coupling, not a proof of globally optimal algorithms or fresh Windows/game compatibility",
  "production_memory_contract": "Only transient heap in production;generic allocator/PTD sources and declarations isolated under tests/support with test-target-only include visibility",
  "snapshot_lookup_contract": "Borrowed immutable snapshot; direct section only; exact keys; last leaf across aliases; present-empty differs from missing; raw bytes preserved; no normalized-state replacement",
  "record_projection_contract": "Parser-validated borrowed tokens copied to owned fields; Content ignores empty updates while Entitlement replaces with empty; defaults/order/nested materialization preserved; all-or-nothing ConfigStore publication",
  "project_name": "REDFIELD",
  "code_identity": "preloader_l",
  "code_name_contract": "Project name is display/metadata only;code identity is preloader_l;configuration filename is the independent surge.cfg compatibility contract",
  "projection_borrow_contract": "All three projections share SourceView;staged Achievement strings borrow parse source until finalize;published records own strings;failed candidate destruction is RAII-owned by ConfigStore",
  "configuration_file": "surge.cfg",
  "configuration_capture_contract": "Required staging references;shared parser-validated SourceView;published strings owned;only surge.cfg next to absolute module path;no CWD or DLL-stem fallback",
  "build_configuration_contract": {
    "source_tree": "One shared maintained core;no Debug/production source forks",
    "python_windows": "One shared BuildSession;fixedindependent production/debug/native/crt/verify profiles",
    "cmake_msvc": "Static CRT;Debug /MTd;other configurations /MT;not executed here",
    "native_test": "Separate tests/native/dll_entry.cpp andobserver;three native ABI exports absent fromproduction source/include closure",
    "test_support": "Two TU and two headers under tests/support;only test targets see its include root;native/ABI hosts under tests/native",
    "operator_profiles": "build_production/debug/native_acceptance/crt_acceptance.cmd;one BuildSession;fixed separate build/profile andnonproduction dist roots",
    "production": "Release /O2 /MT /GS;profile-owned RC compatibility VERSIONINFO;actual link audit+ordered five Golden gates;validated dist/preloader_l.dll onlyafterallpass",
    "debug": "Separate /Od /Zi /MTd /GS build/debug anddist/debug;shared source bodies compiled into independent objects;dedicated diagnostic-only composition pending",
    "native": "Separate /MT objects andnative_entry role;shared WindowsWorker template withouttestmacro;current hostcoverage only",
    "crt": "Separate /MT /GS build/crt,public export/dynamic CRT import/entry checks andcurrent public/native hosts;full old CRT/stress/Golden blackbox pending",
    "developer": "Aggregate build/verify/<platform-sanitizer>;never dist",
    "cmake": "Developer aggregate/preflight andresource source;not production dist authority",
    "profile_example": "Registered test_profile_response argument reads actual examples/surge.cfg;example includes9 explicit User defaults because missing loaded fields intentionally stay empty",
    "golden": "One immutable bounded PE image model;only URSYNEX mutates allowlisted metadata/checksum;four laterstages read-only;source/packagehygiene scopedLOCAL_REFACTOR_SOURCE_PACKAGE",
    "native_composition": "Dedicated tests/native/dll_entry.cpp;no production test macro/exports/state;shared worker template,empty production observer"
  },
  "registry_value_output": "Borrowed synchronous byte-storage writer; no allocation, config lookup, hook state or Win32 calls. Policy owns conversion buffer and frees after writer returns."
