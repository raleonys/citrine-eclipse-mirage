  "module_contracts": {
    "src/config": "Immutable ConfigStore snapshots and explicit hook binding; no global runtime service adapter",
    "src/core": "Per-owner worker/runtime, snapshot projections, transactions and response formatting",
    "src/net": "Serialized socket/peer ownership and drain before configuration retirement",
    "src/runtime": "Explicit intrusive transient heap owner; copy callback descriptor, retain context/module duty across failed or detached release; generic PTD/CRT models remain tests/support only",
    "src/platform": "Singleton executable patch/registry gate state owned by WindowsHooks; retained on teardown failure",
    "src/windows": "Production composition root andone shared worker implementation;test fault/counter ownership onlyintests/native",
    "src/xml": "Single TinyXML2 owned DOM; representation-tagged source vs semantic text",
    "src/handlers": "Bounded request-to-response functions, no global store mutation",
    "src/router": "Static exact-name dispatch descriptors",
    "src/codec": "Strict byte conversion",
    "src/hash": "Deterministic compatibility hashing"
  },
