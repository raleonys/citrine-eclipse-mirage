function(portable_check name)
  add_executable(${name} ${ARGN})
  target_include_directories(${name} PRIVATE include "${PROJECT_SOURCE_DIR}")
  target_link_libraries(${name} PRIVATE portable_config)
  add_test(NAME ${name} COMMAND ${name})
endfunction()
